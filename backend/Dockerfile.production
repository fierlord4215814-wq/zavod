FROM node:20-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json

RUN npm ci --workspace backend

COPY backend/tsconfig.json backend/tsconfig.build.json backend/
COPY backend/src backend/src
COPY backend/prisma/schema.prisma backend/prisma/system-foundation.cjs backend/prisma/
COPY backend/prisma/migrations backend/prisma/migrations

RUN npm run prisma:generate --workspace backend && npm run build --workspace backend

ENV NODE_ENV=production
ARG APP_VERSION=1.0.0-source-unverified
ENV APP_VERSION=${APP_VERSION}
WORKDIR /app

EXPOSE 3000

CMD ["npm", "run", "start", "--workspace", "backend"]
