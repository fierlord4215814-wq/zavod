generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeState {
  AVAILABLE
  ASSIGNED
  WASHING
  TIME_ROLE
  OFF_SHIFT
}

enum LineStatus {
  WORK
  PAUSE
  STOP
}

enum TaskStatus {
  NEW
  IN_PROGRESS
  DONE
}

enum TaskType {
  URGENT
  LONG
}

enum WashStatus {
  IN_PROGRESS
  REVIEW
  DONE
}

enum OkkStatus {
  BLOCKED
  DECISION
  CLOSED
  UNBLOCKED
  COMPLETION_PENDING
  COMPLETED
  ARCHIVED
}

enum StockStatus {
  ON_STOCK
  ISSUED
  ARCHIVED
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum UserRole {
  ADMIN
  MANAGEMENT
  OKK
  TECHNOLOG
  MASTER
  WORKER
  STORE
  OTHER
  TECH_MECHANIC
  TECH_ELECTRIC
  TECH_HOLOD
  TECH_KIPIA
  TECH_SANTECHNIK
  CONTRACTOR
  CONTRACTOR_LEAD
}

enum AssignmentRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum DepartmentScope {
  LOCAL
  GLOBAL
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum ShiftType {
  DAY
  NIGHT
}

enum ShiftSessionStatus {
  ACTIVE
  ENDED
  AUTO_CLOSED
}

enum AssignmentKind {
  LINE
  WASH
  TIME
  WORK_AREA
}

enum ReturnProductionStatus {
  ACTIVE
  COMPLETION_MARKED
  COMPLETED
  ARCHIVED
}

enum QuantityReleaseSourceType {
  OKK
  RETURN
}

enum WorkAreaShiftStatus {
  ACTIVE
  CLOSED
}

enum ShiftWillBeStatus {
  WILL_BE
  CANCELLED
  REMOVED_BY_MASTER
}

enum ContractorSubmissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PARTIALLY_APPROVED
}

enum ContractorSubmissionItemStatus {
  PROPOSED
  APPROVED
  REJECTED
}

enum ContractorActualStatus {
  PLANNED
  ARRIVED
  ABSENT
}

enum ShiftReturnRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttachmentEntityType {
  TASK
  TASK_COMMENT
  WASH_SESSION
  WASH_MESSAGE
  WASH_ISSUE
  WASH_CONTROL_ITEM
  WASH_OKK_REVIEW
  OKK_RECORD
  STOCK_DEFECT
  RETURN_RECORD
  SHIFT_LOG
  SHIFT_LOG_COMMENT
  MINIMUM_STOCK_ITEM
  ORDER_REQUEST
  MINIMUM_STOCK_MOVEMENT
  CHECKLIST_RUN
  CHECKLIST_RUN_ROW
  CHECKLIST_ENTRY
  CHECKLIST_TEMPLATE_ROW
  CHAT_MESSAGE
  ERROR_REPORT
  ANNOUNCEMENT
  COMMON
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
}

enum AnnouncementRecurrence {
  NONE
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum UserProfileNoteVisibility {
  MANAGEMENT
  ADMIN
}

enum ChecklistTemplateScope {
  DEPARTMENT
  LINE
}

enum ChecklistRunStatus {
  ACTIVE
  PAUSED
  CLOSED
  AUTO_CLOSED
}

enum ChecklistRunRowStatus {
  PENDING
  OK
  NA
  ISSUE
}

enum ShiftLogStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum DefrostStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MinimumStockMovementType {
  TAKE
  RESTOCK
  ADJUSTMENT_RESERVED
}

enum OrderRequestSourceType {
  AUTO_FROM_STOCK
  MANUAL
}

enum OrderRequestStatus {
  ACTIVE
  ORDERED
  NOT_NEEDED
  CLOSED_RESERVED
}

enum AttachmentKind {
  PHOTO
  VIDEO
  AUDIO
  FILE
}

enum ChatType {
  FACTORY
  DEPARTMENT
  MANAGEMENT
  SYSTEM
  CUSTOM
  DIRECT
}

enum ChatMessageKind {
  USER
  SYSTEM
}

enum ChatMemberRole {
  OWNER
  ADMIN
  MEMBER
}

model Factory {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
  deactivatedAt DateTime?
  deactivatedById String?
  deactivationReason String?
  recoveryUntil DateTime?
  restoredAt DateTime?
  restoredById String?

  departments Department[]
  userAccess  UserFactoryAccess[]
  audits      AuditLog[]
  linePositions LinePosition[]
  lineStaffingTemplates LineStaffingTemplate[]
  lineShiftStates LineShiftState[]
  lineShiftResults LineShiftResult[]
  lineShiftWorkPlans LineShiftWorkPlan[]
  plannedLineAssignments PlannedLineAssignment[]
  plannedShiftAssignments PlannedShiftAssignment[]
  attachments Attachment[]
  shiftSettings ShiftSettings?
  shiftWillBe ShiftWillBe[]
  contractorShiftSubmissions ContractorShiftSubmission[]
  shiftReturnRequests ShiftReturnRequest[]
  taskSettings TaskSettings?
  taskDepartmentRecipients TaskDepartmentRecipient[]
  washSettings WashSettings?
  washEvents WashEvent[]
  washControlItems WashControlItem[]
  washOkkReviews WashOkkReview[]
  orderSettings OrderSettings?
  checklistSettings ChecklistSettings?
  defrostSettings DefrostSettings?
  defrostEvents DefrostEvent[]
  chambers Chamber[]
  chats Chat[]
  chatPolls ChatPoll[]
  chatSettings ChatSettings?
  errorReports ErrorReport[]
  announcements Announcement[]
  announcementSettings AnnouncementSettings?
  userSkills UserSkill[]
  userProfileNotes UserProfileNote[]
  workAreas WorkArea[]
  workAreaShiftStates WorkAreaShiftState[]
  jobTitles JobTitle[]
  pushSubscriptions PushSubscription[]
  externalCompanies ExternalCompany[]
  assignmentRequests AssignmentRequest[]
  quantityReleaseOperations QuantityReleaseOperation[]
}

model Department {
  id        String          @id @default(uuid())
  factoryId String?
  name      String
  normalizedName String?
  code      String
  scope     DepartmentScope @default(LOCAL)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt
  deletedAt DateTime?
  deactivatedAt DateTime?
  deactivatedById String?
  deactivationReason String?
  recoveryUntil DateTime?
  restoredAt DateTime?
  restoredById String?

  factory    Factory?            @relation(fields: [factoryId], references: [id], onDelete: SetNull)
  userAccess UserFactoryAccess[]
  taskRecipients TaskDepartmentRecipient[]
  checklistTemplates ChecklistTemplate[]
  chats Chat[]
  chatMembers ChatMember[]
  chatMessages ChatMessage[]
  announcements Announcement[]
  announcementAudiences AnnouncementDepartment[]
  workAreas WorkArea[]
  jobTitles JobTitle[]
  assignmentRequests AssignmentRequest[]

  @@unique([factoryId, code])
  @@index([scope, isActive])
}

model ExternalCompany {
  id             String   @id @default(uuid())
  factoryId      String
  name           String
  normalizedName String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  deactivatedAt  DateTime?
  deactivatedById String?
  deactivationReason String?

  factory Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)
    userAccess UserFactoryAccess[]
    assignmentRequests AssignmentRequest[]
    contractorShiftSubmissions ContractorShiftSubmission[]

  @@unique([factoryId, normalizedName])
  @@index([factoryId, isActive])
}

model JobTitle {
  id               String    @id @default(uuid())
  factoryId        String?
  departmentId     String?
  parentJobTitleId String?
  name             String
  code             String
  baseRole         UserRole
  permissionPreset String?
  description      String?
  shiftDurationHours Int     @default(12)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  deletedAt        DateTime?
  deactivatedAt    DateTime?
  deactivatedById  String?
  deactivationReason String?
  recoveryUntil    DateTime?
  restoredAt       DateTime?
  restoredById     String?

  factory    Factory?    @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  parentJobTitle JobTitle? @relation("JobTitleHierarchy", fields: [parentJobTitleId], references: [id], onDelete: SetNull)
  childJobTitles JobTitle[] @relation("JobTitleHierarchy")
  userAccess UserFactoryAccess[]

  @@unique([factoryId, code])
  @@index([factoryId, isActive])
  @@index([departmentId])
  @@index([parentJobTitleId])
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]
}

model RolePermission {
  id             String   @id @default(uuid())
  role           UserRole
  permissionCode String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@unique([role, permissionCode])
  @@index([permissionCode])
}

model SystemFoundationState {
  id        String   @id
  version   Int
  mode      String
  details   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model User {
  id            String        @id @default(uuid())
  factoryId     String
  lastName      String?
  firstName     String?
  middleName    String?
  employeeState EmployeeState @default(AVAILABLE)
  version       Int           @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  blockedAt     DateTime?
  deletedAt     DateTime?
  role          UserRole      @default(WORKER)
  phone         String?
  normalizedPhone String?      @unique
  passwordHash  String?
  passwordResetRequired Boolean @default(false)
  passwordChangedAt DateTime?
  lastLoginAt   DateTime?
  failedLoginCount Int         @default(0)
  failedLoginStage Int         @default(0)
  lockedUntil   DateTime?
  authUpdatedAt DateTime?
  passwordRecoveryHash String?
  passwordRecoveryExpiresAt DateTime?
  passwordRecoveryIssuedAt DateTime?
  passwordRecoveryIssuedById String?
  passwordRecoveryFactoryId String?
  passwordRecoveryConsumedAt DateTime?

  assignments        Assignment[]
  shiftSessions      ShiftSession[] @relation("ShiftSessionUser")
  startedShiftSessions ShiftSession[] @relation("ShiftStartedBy")
  endedShiftSessions   ShiftSession[] @relation("ShiftEndedBy")
  createdTasks       Task[]         @relation("TaskCreatedBy")
  assignedTasks      Task[]         @relation("TaskAssignedTo")
  takenTasks         Task[]         @relation("TaskTakenBy")
  doneTasks          Task[]         @relation("TaskDoneBy")
  taskComments       TaskComment[]
  taskAssignees      TaskAssignee[] @relation("TaskAssigneeUser")
  assignedTaskAssignees TaskAssignee[] @relation("TaskAssigneeAssignedBy")
  taskHistory        TaskHistory[]
  taskReads          TaskRead[]
  startedWashes      WashSession[]  @relation("WashStartedBy")
  washMessages       WashMessage[]
  washIssues         WashIssue[]
  washIssueAssignments WashIssue[] @relation("WashIssueAssignedTo")
  washIssueResolved WashIssue[] @relation("WashIssueResolvedBy")
  washEvents        WashEvent[]
  createdWashControlItems WashControlItem[] @relation("WashControlCreatedBy")
  assignedWashControlItems WashControlItem[] @relation("WashControlAssignedTo")
  doneWashControlItems WashControlItem[] @relation("WashControlDoneBy")
  washOkkReviews    WashOkkReview[] @relation("WashOkkReviewUser")
  createdOkkRecords  OkkRecord[]    @relation("OkkCreatedBy")
  assignedOkkRecords OkkRecord[]    @relation("OkkAssignedMaster")
  stockDefects       StockDefect[]  @relation("StockDefectCreatedBy")
  returnRecords      ReturnRecord[]     @relation("ReturnRecordCreatedBy")
  shiftLogs          ShiftLog[]         @relation("ShiftLogCreatedBy")
  shiftLogComments   ShiftLogComment[]
  factoryAccess      UserFactoryAccess[]
  permissionOverrides UserPermissionOverride[]
  audits             AuditLog[]
  createdLineShiftResults LineShiftResult[] @relation("LineShiftResultCreatedBy")
  createdLineShiftWorkPlans LineShiftWorkPlan[] @relation("LineShiftWorkPlanCreatedBy")
  updatedLineShiftWorkPlans LineShiftWorkPlan[] @relation("LineShiftWorkPlanUpdatedBy")
  plannedLineAssignments PlannedLineAssignment[] @relation("PlannedLineAssignmentUser")
  createdPlannedLineAssignments PlannedLineAssignment[] @relation("PlannedLineAssignmentCreatedBy")
  releasedPlannedLineAssignments PlannedLineAssignment[] @relation("PlannedLineAssignmentReleasedBy")
  plannedShiftAssignments PlannedShiftAssignment[] @relation("PlannedShiftAssignmentUser")
  createdPlannedShiftAssignments PlannedShiftAssignment[] @relation("PlannedShiftAssignmentCreatedBy")
  releasedPlannedShiftAssignments PlannedShiftAssignment[] @relation("PlannedShiftAssignmentReleasedBy")
  uploadedAttachments Attachment[] @relation("AttachmentUploadedBy")
  shiftWillBe ShiftWillBe[] @relation("ShiftWillBeUser")
  removedShiftWillBe ShiftWillBe[] @relation("ShiftWillBeRemovedBy")
  contractorShiftSubmissions ContractorShiftSubmission[] @relation("ContractorSubmissionLead")
  contractorSubmissionItems ContractorShiftSubmissionItem[] @relation("ContractorSubmissionItemUser")
  decidedContractorSubmissionItems ContractorShiftSubmissionItem[] @relation("ContractorSubmissionItemDecidedBy")
  actualContractorSubmissionItems ContractorShiftSubmissionItem[] @relation("ContractorSubmissionItemActualBy")
  shiftReturnRequests ShiftReturnRequest[] @relation("ShiftReturnRequestUser")
  requestedShiftReturnRequests ShiftReturnRequest[] @relation("ShiftReturnRequestedBy")
  decidedShiftReturnRequests ShiftReturnRequest[] @relation("ShiftReturnDecidedBy")
  checklistRuns ChecklistRun[]
  closedChecklistRuns ChecklistRun[] @relation("ChecklistRunClosedBy")
  checklistPauseEvents ChecklistPauseEvent[] @relation("ChecklistPausePausedBy")
  checklistPauseResumeEvents ChecklistPauseEvent[] @relation("ChecklistPauseResumedBy")
  startedDefrostEvents DefrostEvent[] @relation("DefrostStartedBy")
  endedDefrostEvents DefrostEvent[] @relation("DefrostEndedBy")
  createdChats Chat[] @relation("ChatCreatedBy")
  chatMembers ChatMember[]
  chatMessages ChatMessage[] @relation("ChatMessageAuthor")
  chatMessageReactions ChatMessageReaction[]
  chatPolls ChatPoll[] @relation("ChatPollCreatedBy")
  chatPollVotes ChatPollVote[]
  chatReads ChatRead[]
  authoredErrorReports ErrorReport[] @relation("ErrorReportAuthor")
  closedErrorReports ErrorReport[] @relation("ErrorReportClosedBy")
  authoredAnnouncements Announcement[] @relation("AnnouncementAuthor")
  announcementReads AnnouncementRead[]
  skills UserSkill[] @relation("UserSkillUser")
  recommendedSkills UserSkill[] @relation("UserSkillRecommendedBy")
  profileNotes UserProfileNote[] @relation("UserProfileNoteUser")
  authoredProfileNotes UserProfileNote[] @relation("UserProfileNoteAuthor")
  pushSubscriptions PushSubscription[]
  requestedAssignmentRequests AssignmentRequest[] @relation("AssignmentRequestRequestedBy")
  decidedAssignmentRequests AssignmentRequest[] @relation("AssignmentRequestDecidedBy")
  quantityReleaseOperations QuantityReleaseOperation[] @relation("QuantityReleaseActor")

  @@index([blockedAt], map: "User_blockedAt_idx")
}

model Attachment {
  id           String               @id @default(uuid())
  factoryId    String?
  uploadedById String
  entityType   AttachmentEntityType
  entityId     String
  kind         AttachmentKind
  operationId  String?
  originalName String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  publicUrl    String?
  width        Int?
  height       Int?
  durationSec  Int?
  createdAt    DateTime             @default(now())
  deletedAt    DateTime?

  factory    Factory? @relation(fields: [factoryId], references: [id], onDelete: SetNull)
  uploadedBy User     @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  checklistTemplateReferences ChecklistTemplateRow[] @relation("ChecklistTemplateReference")
  checklistRunReferences ChecklistRunRow[] @relation("ChecklistRunReference")

  @@index([factoryId, entityType, entityId])
  @@index([uploadedById, createdAt])
  @@index([entityType, entityId])
  @@unique([uploadedById, operationId])
}

model UserFactoryAccess {
  id           String   @id @default(uuid())
  userId       String
  factoryId    String
  role         UserRole
  departmentId String?
  jobTitleId   String?
  companyId    String?
  isGuest      Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  deactivatedAt DateTime?
  deactivatedById String?
  deactivationReason String?
  recoveryUntil DateTime?
  restoredAt DateTime?
  restoredById String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  factory    Factory     @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  jobTitle   JobTitle?   @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  company    ExternalCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([userId, factoryId])
  @@index([factoryId, role])
  @@index([departmentId])
  @@index([jobTitleId])
  @@index([companyId])
}

model AssignmentRequest {
  id             String                  @id @default(uuid())
  factoryId      String
  requestedById  String
  requestedRole  UserRole
  departmentId   String?
  companyId      String?
  comment        String?
  status         AssignmentRequestStatus @default(PENDING)
  activeKey      String?                 @unique
  operationId    String?                 @unique
  version        Int                     @default(1)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @default(now()) @updatedAt
  decidedAt      DateTime?
  decidedById    String?
  decisionReason String?
  decisionSnapshot Json?

  factory     Factory          @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  requestedBy User             @relation("AssignmentRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedBy   User?            @relation("AssignmentRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  department  Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  company     ExternalCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([factoryId, status, createdAt])
  @@index([requestedById, factoryId, createdAt])
  @@index([departmentId, status])
  @@index([companyId, status])
}

model UserPermissionOverride {
  id             String           @id @default(uuid())
  userId         String
  factoryId      String?
  permissionCode String
  effect         PermissionEffect
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@unique([userId, factoryId, permissionCode])
  @@index([factoryId])
  @@index([permissionCode])
}

model AuditLog {
  id         String   @id @default(uuid())
  factoryId  String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    Json
  createdAt  DateTime @default(now())

  factory Factory? @relation(fields: [factoryId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([factoryId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model Notification {
  id           String               @id @default(uuid())
  factoryId    String?
  departmentId String?
  userId       String?
  type         String
  title        String
  message      String
  entityType   String?
  entityId     String?
  operationId  String?              @unique
  severity     NotificationSeverity @default(INFO)
  readAt       DateTime?
  createdAt    DateTime             @default(now())
  expiresAt    DateTime?

  @@index([userId, readAt, createdAt])
  @@index([factoryId, departmentId, readAt, createdAt])
  @@index([type, createdAt])
  @@index([entityType, entityId])
}

model PushSubscription {
  id          String   @id @default(uuid())
  userId      String
  factoryId   String
  endpoint    String   @unique
  p256dh      String
  auth        String
  userAgent   String?
  deviceLabel String?
  isActive    Boolean  @default(true)
  revokedAt   DateTime?
  revokedById String?
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  factory Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@index([userId, factoryId, isActive])
  @@index([factoryId, isActive])
  @@index([revokedAt])
}

model ChatSettings {
  id                  String   @id @default(uuid())
  factoryId           String   @unique
  chatEnabled         Boolean  @default(true)
  attachmentsEnabled  Boolean  @default(true)
  editWindowMinutes   Int      @default(15)
  deleteWindowMinutes Int      @default(15)
  retentionMonths     Int      @default(2)
  voiceReserved       Boolean  @default(false)
  videoReserved       Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  factory Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)
}

model Chat {
  id           String    @id @default(uuid())
  factoryId    String?
  departmentId String?
  type         ChatType
  title        String
  description  String?
  isActive     Boolean   @default(true)
  isHidden     Boolean   @default(false)
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  archivedAt   DateTime?

  factory    Factory?     @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  department Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy  User         @relation("ChatCreatedBy", fields: [createdById], references: [id])
  members    ChatMember[]
  messages   ChatMessage[]
  polls      ChatPoll[]
  reads      ChatRead[]

  @@index([factoryId, type, isActive])
  @@index([departmentId, type, isActive])
  @@index([archivedAt])
}

model ChatMember {
  id                     String         @id @default(uuid())
  chatId                 String
  userId                 String?
  roleCode               UserRole?
  departmentId           String?
  membershipRole         ChatMemberRole @default(MEMBER)
  canRead                Boolean        @default(true)
  canWrite               Boolean        @default(false)
  canManage              Boolean        @default(false)
  hiddenAt               DateTime?
  communicationBlockedAt DateTime?
  leftAt                 DateTime?
  removedAt              DateTime?
  membershipUpdatedAt    DateTime?
  createdAt              DateTime       @default(now())

  chat       Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@unique([chatId, userId])
  @@index([userId])
  @@index([userId, hiddenAt])
  @@index([chatId, membershipRole])
  @@index([departmentId])
  @@index([roleCode])
}

model ChatMessage {
  id           String          @id @default(uuid())
  factoryId    String?
  departmentId String?
  chatId       String
  authorId     String?
  replyToMessageId String?
  kind         ChatMessageKind @default(USER)
  text         String
  entityType   String?
  entityId     String?
  operationId  String?
  createdAt    DateTime        @default(now())
  editedAt     DateTime?
  deletedAt    DateTime?

  chat       Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  author     User?       @relation("ChatMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  replyToMessage ChatMessage? @relation("ChatMessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies ChatMessage[] @relation("ChatMessageReplies")
  reactions ChatMessageReaction[]
  poll ChatPoll?

  @@unique([authorId, operationId])
  @@index([chatId, createdAt])
  @@index([chatId, replyToMessageId])
  @@index([factoryId, createdAt])
  @@index([departmentId, createdAt])
}

model ChatMessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  deletedAt DateTime?

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId, deletedAt])
  @@index([userId, createdAt])
}

model ChatPoll {
  id             String   @id @default(uuid())
  factoryId      String?
  chatId         String
  messageId      String   @unique
  createdById    String
  question       String
  anonymous      Boolean  @default(false)
  multipleChoice Boolean  @default(false)
  allowRevote    Boolean  @default(true)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  deletedAt      DateTime?

  factory   Factory?         @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  chat      Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
