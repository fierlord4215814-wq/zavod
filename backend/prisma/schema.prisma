  log  ShiftLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([logId])
  @@index([userId])
}

model ShiftLogRead {
  id     String   @id @default(uuid())
  logId  String
  userId String
  readAt DateTime @default(now())

  log ShiftLog @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@unique([logId, userId])
  @@index([userId])
}

model ShiftSession {
  id          String             @id @default(uuid())
  factoryId   String
  userId      String
  startedAt   DateTime
  endedAt     DateTime?
  shiftType   ShiftType
  status      ShiftSessionStatus @default(ACTIVE)
  startedById String?
  endedById   String?
  autoClosed  Boolean            @default(false)
  durationHours Int               @default(12)
  plannedEndAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
  version     Int                @default(1)

  user      User  @relation("ShiftSessionUser", fields: [userId], references: [id], onDelete: Cascade)
  startedBy User? @relation("ShiftStartedBy", fields: [startedById], references: [id], onDelete: SetNull)
  endedBy   User? @relation("ShiftEndedBy", fields: [endedById], references: [id], onDelete: SetNull)
  lineShiftStates LineShiftState[]
  workAreaShiftStates WorkAreaShiftState[]
  lineShiftResults LineShiftResult[]
  lineShiftWorkPlans LineShiftWorkPlan[]
  returnRequests ShiftReturnRequest[]

  @@index([factoryId, status])
  @@index([userId, factoryId, status])
  @@index([startedAt])
  @@index([status, plannedEndAt])
}

model ShiftSettings {
  id                                String   @id @default(uuid())
  factoryId                         String   @unique
  dayShiftStartTime                 String   @default("08:00")
  dayShiftEndTime                   String   @default("20:00")
  nightShiftStartTime               String   @default("20:00")
  nightShiftEndTime                 String   @default("08:00")
  willBeOpenHoursBeforeShift        Int      @default(24)
  noShowCheckMinutesAfterShiftStart Int      @default(60)
  minAssignmentMoveIntervalMinutes  Int      @default(5)
  contractorLeadMaxPeoplePerShift   Int      @default(6)
  returnRequestEnabled              Boolean  @default(true)
  autoCloseChecklistsAtShiftEnd     Boolean  @default(false)
  sendHomeRequiresComment           Boolean  @default(true)
  willBeCancelRequiresComment       Boolean  @default(true)
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @default(now()) @updatedAt

  factory Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)
}

model ShiftWillBe {
  id              String            @id @default(uuid())
  factoryId       String
  userId          String
  targetShiftDate DateTime
  shiftType       ShiftType
  status          ShiftWillBeStatus @default(WILL_BE)
  comment         String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
  cancelledAt     DateTime?
  removedById     String?
  removedAt       DateTime?

  factory   Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  user      User    @relation("ShiftWillBeUser", fields: [userId], references: [id], onDelete: Cascade)
  removedBy User?   @relation("ShiftWillBeRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)

  @@index([factoryId, targetShiftDate, shiftType, status])
  @@index([userId, targetShiftDate, shiftType])
}

model ContractorShiftSubmission {
  id                  String                     @id @default(uuid())
  factoryId           String
  leadId              String
  companyId           String?
  companyNameSnapshot String?
  targetShiftDate     DateTime
  shiftType           ShiftType
  status              ContractorSubmissionStatus @default(DRAFT)
  comment             String?
  version             Int                        @default(1)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @default(now()) @updatedAt

  factory Factory                   @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  lead    User                      @relation("ContractorSubmissionLead", fields: [leadId], references: [id], onDelete: Cascade)
  company ExternalCompany?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  items   ContractorShiftSubmissionItem[]

  @@index([factoryId, targetShiftDate, shiftType, status], map: "ContractorShiftSubmission_factoryId_targetShiftDate_shiftType_s")
  @@index([leadId, targetShiftDate, shiftType])
  @@index([companyId, targetShiftDate, shiftType], map: "ContractorShiftSubmission_companyId_targetShiftDate_shiftType_i")
}

model ContractorShiftSubmissionItem {
  id               String                         @id @default(uuid())
  submissionId     String
  contractorUserId String
  status           ContractorSubmissionItemStatus @default(PROPOSED)
  actualStatus     ContractorActualStatus         @default(PLANNED)
  actualById       String?
  actualAt         DateTime?
  masterComment    String?
  decidedById      String?
  decidedAt        DateTime?
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @default(now()) @updatedAt
  version          Int                            @default(1)

  submission     ContractorShiftSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  contractorUser User                      @relation("ContractorSubmissionItemUser", fields: [contractorUserId], references: [id], onDelete: Cascade)
  decidedBy      User?                     @relation("ContractorSubmissionItemDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  actualBy       User?                     @relation("ContractorSubmissionItemActualBy", fields: [actualById], references: [id], onDelete: SetNull)

  @@unique([submissionId, contractorUserId])
  @@index([contractorUserId])
  @@index([status])
  @@index([actualStatus])
}

model ShiftReturnRequest {
  id              String                   @id @default(uuid())
  factoryId       String
  userId          String
  shiftSessionId  String?
  requestedById   String
  reason          String
  status          ShiftReturnRequestStatus @default(PENDING)
  decidedById     String?
  decisionComment String?
  createdAt       DateTime                 @default(now())
  decidedAt       DateTime?
  updatedAt       DateTime                 @default(now()) @updatedAt

  factory      Factory       @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  user         User          @relation("ShiftReturnRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  requestedBy  User          @relation("ShiftReturnRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedBy    User?         @relation("ShiftReturnDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  shiftSession ShiftSession? @relation(fields: [shiftSessionId], references: [id], onDelete: SetNull)

  @@index([factoryId, status, createdAt])
  @@index([userId, status])
  @@index([shiftSessionId])
}


model ProcessedOperation {
  id          String   @id @default(uuid())
  userId      String
  operationId String
  resultKey   String?
  createdAt   DateTime @default(now())

  @@unique([userId, operationId])
  @@index([createdAt])
}
