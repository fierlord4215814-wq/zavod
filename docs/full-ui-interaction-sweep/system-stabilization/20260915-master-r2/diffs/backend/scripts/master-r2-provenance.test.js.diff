+const { WashService } = require('../dist/modules/wash/wash.service');
+const visibility = require('../dist/common/pilot-visibility');
+const documentedStart = /^__PFFV5_P17C_BROWSER_\d{13}__:wash-start$/;
+function projectionEvidence({ factoryId, session, operations, invocations }) {
+  if (!session || session.factoryId !== factoryId) return 'NOT_IN_SCOPE';
+  const candidates = operations.filter(row => row.userId === session.startedById && row.resultKey === session.id && documentedStart.test(row.operationId));
+  if (!candidates.length) return 'NEEDS_FACTS';
+  if (candidates.length !== 1) return 'AMBIGUOUS';
+  const proofs = invocations.filter(row => row.owner === 'WashService.startWash' && row.userId === session.startedById && row.operationId === candidates[0].operationId && row.factoryId === factoryId && row.resultId === session.id);
+  // Polymorphic resultKey by itself has no stored operation-kind authority.
+  return proofs.length === 1 ? 'PROVEN_PROJECTION_ONLY' : 'NEEDS_KIND_WITNESS';
+}
+async function startedFixture() {
+  const m = memory(), factoryId = 'provenance-factory', userId = '79c3d675-4b59-4ca0-81aa-b8a79b33c100', operations = m.operations;
+  const user = { id: userId, factoryId, role: 'MASTER', blockedAt: null, deletedAt: null }, sessions = [];
+  m.data.user = m.model('user', [user]);
+  m.data.userFactoryAccess = m.model('access', [{ userId, factoryId, isActive: true, isGuest: false, user }], { includes: ['user'], compounds: ['userId_factoryId'] });
+  m.data.washSession = m.model('washSession', sessions, { includes: ['line', 'startedBy', 'assignments', 'issues', 'messages', 'events', 'controlItems', 'okkReviews'], defaults: { id: 'c037932b-a0a2-4434-89fe-095f89ddc100', lineId: null }, enrich: row => ({ ...row, line: null, startedBy: { id: userId }, assignments: [], issues: [], messages: [], events: [], controlItems: [], okkReviews: [] }) });
+  m.data.shiftSession = m.model('shiftSession', []); m.data.washEvent = m.model('washEvent', []);
+  const service = new WashService({ db: m.db }, m.ws, m.audit, m.attachments, strict({}));
+  const operationId = '__PFFV5_P17C_BROWSER_1789400576992__:wash-start', target = { targetType: 'OTHER', objectName: 'Санитарная зона 576992', objectDescription: 'Проверка связи рабочего экрана' };
+  const session = await service.startWash(target, userId, operationId, factoryId);
+  const invocations = [{ owner: 'WashService.startWash', userId, operationId, factoryId, resultId: session.id }];
+  return { ...m, factoryId, userId, session, sessions, operations, invocations, target, service };
+}
+for (const scenario of ['proven', 'absent', 'ambiguous', 'cross-factory', 'different-author', 'wrong-result-key', 'wrong-operation-kind', 'missing-kind-witness']) test(`R2-C014 conservative projection evidence contract ${scenario}`, async () => {
+  const f = await startedFixture(), input = { factoryId: f.factoryId, session: copy(f.session), operations: copy(f.operations), invocations: copy(f.invocations) };
+  let expected = 'PROVEN_PROJECTION_ONLY';
+  if (scenario === 'absent') { input.operations = []; expected = 'NEEDS_FACTS'; }
+  if (scenario === 'ambiguous') { input.operations.push({ ...copy(input.operations[0]), operationId: '__PFFV5_P17C_BROWSER_1789400576993__:wash-start' }); expected = 'AMBIGUOUS'; }
+  if (scenario === 'cross-factory') { input.factoryId = 'other-factory'; expected = 'NOT_IN_SCOPE'; }
+  if (scenario === 'different-author') { input.operations[0].userId = 'another-actor'; expected = 'NEEDS_FACTS'; }
+  if (scenario === 'wrong-result-key') { input.operations[0].resultKey = 'another-type-or-session'; expected = 'NEEDS_FACTS'; }
+  if (scenario === 'wrong-operation-kind') { input.operations[0].operationId = input.operations[0].operationId.replace(':wash-start', ':wash-complete'); expected = 'NEEDS_FACTS'; }
+  if (scenario === 'missing-kind-witness') { input.invocations = []; expected = 'NEEDS_KIND_WITNESS'; }
+  const before = copy([input, f.sessions, f.operations, f.writes]);
+  assert.equal(projectionEvidence(input), expected); assert.deepEqual([input, f.sessions, f.operations, f.writes], before);
+  assert.equal(visibility.isRuntimeVisibleWashSession(f.session), true, 'Current parent classifier cannot infer operation provenance from the child/name/UUID');
+  await assert.rejects(f.service.startWash(f.target, f.userId, 'ordinary-second-operation', f.factoryId), denied);
+  assert.equal(f.sessions.length, 1); assert.equal(f.sessions[0].status, 'IN_PROGRESS'); assert.equal(f.operations.length, 1);
+});
