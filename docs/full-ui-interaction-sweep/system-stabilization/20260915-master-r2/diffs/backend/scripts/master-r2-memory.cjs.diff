+const strict = (value, label = 'dependency') => new Proxy(value, {
+  get(target, key) {
+    if (typeof key === 'symbol' || key === 'then') return target[key];
+    if (!(key in target)) throw Error(`UNMOCKED ${label}.${key}`);
+    return target[key];
+  },
+});
