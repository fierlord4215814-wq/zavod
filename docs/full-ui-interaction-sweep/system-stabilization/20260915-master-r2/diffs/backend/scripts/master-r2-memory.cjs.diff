+  return Object.entries(where).every(([key, value]) => {
+    if (value === undefined) return true;
+    if (key === 'AND') return (Array.isArray(value) ? value : [value]).every(item => matches(row, item));
+    if (key === 'OR') return value.some(item => matches(row, item));
