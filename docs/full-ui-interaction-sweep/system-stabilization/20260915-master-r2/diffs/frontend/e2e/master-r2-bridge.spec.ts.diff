+import {expect,test,Page} from '@playwright/test';
+import {isolate,json,open,shot,records,save,errors,unknown,linkedReplies,installEvidenceHooks} from './helpers/frontend-series';
+import {serviceBridge} from './helpers/master-r2-bridge';
+installEvidenceHooks();
+async function attach(page:Page,bridge:ReturnType<typeof serviceBridge>,mode:'publication'|'handover'){
+  await isolate(page,{role:'MASTER',replies:async(r,p)=>{
+    const isBridge=p==='/auth/me'||(mode==='publication'?p.startsWith('/announcements')||['/notifications','/notifications/unread-count'].includes(p):p.startsWith('/shift-log'));
+    if(isBridge){const url=new URL(r.request().url()),response=await bridge.rpc({path:p,method:r.request().method(),query:Object.fromEntries(url.searchParams),body:r.request().postDataJSON(),factory:r.request().headers()['x-factory-id']});await json(r,response.ok?response.value:{message:response.message},response.ok?200:response.status);return true;}
+    return linkedReplies(r,p);
+  }});
+  await page.setViewportSize({width:390,height:844});await page.goto('/');
+}
