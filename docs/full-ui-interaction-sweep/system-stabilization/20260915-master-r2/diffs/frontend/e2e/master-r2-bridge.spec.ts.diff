+    const report=await b.rpc({path:'/announcements/publication-announcement/ack-report'});expect(report.ok).toBe(true);expect(report.value.totals).toEqual({all:1,acknowledged:1,pending:0});
+    const replay=await b.rpc({path:'/announcements/publication-announcement/ack',method:'POST'});expect(replay.ok).toBe(true);
+    state=(await b.rpc({command:'inspect'})).value;expect(state.reads).toHaveLength(1);expect(state.notices[0].readAt).not.toBeNull();
+    await page.locator('.announcement-tabs').getByRole('button',{name:'Архив',exact:true}).click();await expect(page.locator('.announcement-archive-card')).toContainText('Регламент смены');await page.locator('.announcement-archive-card').getByRole('button',{name:'Открыть',exact:true}).click();
+    await expect(page.locator('.announcement-archive-detail')).toContainText('Проверьте ограждение перед началом работы');await shot(page,'J19-actual-personal-archive',{layer:'browser-IPC-actual-controller-guard-service',entityId:'publication-announcement'});
+    await page.goBack();await expect(page.locator('.announcement-archive-detail')).toBeHidden();
+    await b.rpc({command:'revoke'});const denied=await b.rpc({path:'/announcements/publication-announcement/ack',method:'POST'});expect(denied.ok).toBe(false);expect(denied.status).toBe(403);expect((await b.rpc({command:'inspect'})).value.reads).toHaveLength(1);
+    expect(b.traffic.filter(r=>r.direction==='reply'&&!r.ok&&![403,503].includes(r.status))).toEqual([]);expect(unknown).toEqual([]);expect(errors).toEqual([]);
+  }finally{records.push({bridge:'IPC-only',pid:b.pid,traffic:b.traffic});save();await b.close();}
+});
