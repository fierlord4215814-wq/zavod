--- /dev/null
+++ frontend/e2e/helpers/master-r3-context.tsx
@@ -0,0 +1,31 @@
+import React,{useState} from 'react';
+import {createRoot} from 'react-dom/client';
+import {apiClient} from '../../src/api/client';
+import {appStore} from '../../src/store/app.store';
+
+const user={userId:'context-reader',role:'WORKER',isAdmin:false,isGuest:false,departmentId:'context-department',permissions:['tasks.read','people.read']};
+const factories=['context-A','context-B'].map(id=>({id,name:id==='context-A'?'Первая площадка':'Вторая площадка',code:id,isActive:true,role:'WORKER',departmentName:null,isGuest:false}));
+const restore=()=>appStore.setSession({currentUser:user,selectedFactoryId:'context-A',availableFactories:factories,authToken:'isolated-context-token',authStatus:'ready'});
+restore();
+function Host(){
+ const [result,setResult]=useState('READY');
+ const start=async()=>{
+  setResult('PENDING');
+  try{
+   const kind=location.hash.slice(1);
+   let value:unknown;
+   if(kind==='download'){const data=await apiClient.downloadBlob('/r3/context');value={text:await data.blob.text(),count:data.primaryCount};}
+   else if(kind==='upload'){const body=new FormData();body.append('file',new Blob(['Изолированное содержимое'],{type:'text/plain'}),'Проверка.txt');value=await apiClient.uploadWithProgress('/r3/context',body);}
+   else value=await apiClient.post('/r3/context',{zero:0,flag:false,empty:'',nothing:null,absent:undefined,operationId:'r3-stable-key'});
+   setResult(JSON.stringify({delivered:true,value}));
+  }catch(error){setResult(JSON.stringify({delivered:false,error:error instanceof Error?error.name:'UNKNOWN'}));}
+ };
+ return <main><h1>Изолированный контракт API</h1><button onClick={()=>void start()}>Начать</button>
+  <button onClick={()=>{appStore.selectFactory('context-B');appStore.selectFactory('context-A');}}>Завод А–Б–А</button>
+  <button onClick={()=>{appStore.setSession({currentUser:{...user,permissions:['tasks.read']},availableFactories:factories,selectedFactoryId:'context-A'});}}>Отозвать право</button>
+  <button onClick={()=>{appStore.clearAuth();restore();}}>Выход и повторный вход</button>
+  <button onClick={()=>{appStore.setSession({currentUser:{...user,userId:'context-other'},availableFactories:factories,selectedFactoryId:'context-A'});}}>Другой пользователь</button>
+  <output>{result}</output></main>;
+}
+createRoot(document.getElementById('root')!).render(<Host/>);
+