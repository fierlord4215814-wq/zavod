diff --git "a/docs\\theme-switching\\corrections\\20260914-thv03-ops-kpi-layout\\baseline-source\\styles.css" "b/frontend\\src\\styles.css"
index e34fb09e..0594a44d 100644
--- "a/docs\\theme-switching\\corrections\\20260914-thv03-ops-kpi-layout\\baseline-source\\styles.css"
+++ "b/frontend\\src\\styles.css"
@@ -21582,3 +21582,66 @@ body.pwa-standalone {
     background: var(--info-soft);
   }
 }
+
+/* THV-03: Ops KPI cards need local geometry; shared KPI decoration is not content. */
+.ops-audit-screen .ops-metric-grid > .metric-card {
+  min-width: 0;
+  min-height: 112px;
+  align-content: center;
+  gap: 6px;
+  padding: 14px;
+}
+
+.ops-audit-screen .ops-metric-grid > .metric-card::before {
+  display: none;
+  content: none;
+}
+
+.ops-audit-screen :is(
+  .ops-metric-grid,
+  .ops-overview-metric-grid
+) :is(.metric-label, .metric-value, .metric-detail) {
+  min-width: 0;
+  max-width: 100%;
+  overflow: visible;
+  overflow-wrap: normal;
+  word-break: normal;
+  hyphens: none;
+  white-space: normal;
+}
+
+.ops-audit-screen :is(
+  .ops-metric-grid,
+  .ops-overview-metric-grid
+) .metric-label {
+  text-wrap: balance;
+}
+
+@media (max-width: 768px) {
+  .ops-audit-screen .ops-overview-metric-grid {
+    --premium-kpi-columns: 2;
+    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
+    gap: 8px !important;
+  }
+
+  .ops-audit-screen .ops-overview-metric-grid > .metric-card,
+  .ops-audit-screen .ops-metric-grid > .metric-card {
+    min-height: 100px !important;
+    align-content: center !important;
+    gap: 5px !important;
+    padding: 12px !important;
+  }
+
+  .ops-audit-screen .ops-overview-metric-grid .metric-label,
+  .ops-audit-screen .ops-metric-grid .metric-label,
+  .ops-audit-screen .ops-metric-grid .metric-detail {
+    font-size: 12px !important;
+    line-height: 1.25 !important;
+  }
+
+  .ops-audit-screen .ops-overview-metric-grid .metric-value,
+  .ops-audit-screen .ops-metric-grid .metric-value {
+    font-size: 23px !important;
+    line-height: 1.05 !important;
+  }
+}
