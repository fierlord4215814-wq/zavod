+      x: rect.x,
+      y: rect.y,
+      width: rect.width,
+      height: rect.height,
+      right: rect.right,
+      bottom: rect.bottom,
+    });
+    const intersects = (first: DOMRect, second: { left: number; top: number; right: number; bottom: number }) => (
+      Math.min(first.right, second.right) - Math.max(first.left, second.left) > 1
+      && Math.min(first.bottom, second.bottom) - Math.max(first.top, second.top) > 1
+    );
+    const splitWords = (label: HTMLElement) => {
+      const node = Array.from(label.childNodes).find((child) => child.nodeType === Node.TEXT_NODE);
+      if (!node?.textContent) return [];
+      const broken: string[] = [];
+      for (const match of node.textContent.matchAll(/\S+/g)) {
+        if (match.index === undefined) continue;
+        const range = document.createRange();
+        range.setStart(node, match.index);
+        range.setEnd(node, match.index + match[0].length);
+        const wordRects = Array.from(range.getClientRects());
+        const firstLineTop = wordRects[0]?.top;
+        if (firstLineTop !== undefined && wordRects.some((rect) => Math.abs(rect.top - firstLineTop) > 2)) {
+          broken.push(match[0]);
+        }
+      }
+      return broken;
+    };
+    const rootElement = element as HTMLElement;
+    const selector = viewName === 'loss'
+      ? '.ops-analytics .metric-card'
+      : ':scope > .premium-kpi-strip > .metric-card';
+    const cards = Array.from(rootElement.querySelectorAll<HTMLElement>(selector)).map((card, index) => {
+      const cardRect = card.getBoundingClientRect();
+      const label = card.querySelector<HTMLElement>('.metric-label');
+      const value = card.querySelector<HTMLElement>('.metric-value');
+      const detail = card.querySelector<HTMLElement>('.metric-detail');
+      const textElements = [label, value, detail].filter((item): item is HTMLElement => Boolean(item));
+      const textRects = textElements.map((item) => item.getBoundingClientRect());
+      const textContentRects = textElements.map((item) => {
+        const range = document.createRange();
+        range.selectNodeContents(item);
+        return range.getBoundingClientRect();
+      });
+      const pseudo = getComputedStyle(card, '::before');
+      const content = pseudo.content;
