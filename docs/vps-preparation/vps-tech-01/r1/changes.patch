\ No newline at end of file
+# Operator template for a separately installed Nginx TLS endpoint; NOT an active
+# Compose service or a certificate-issuance mechanism. Replace all REPLACE_ values.
+# Only the local frontend port is upstream; its /api and /ws locations route to
+# the backend inside the existing Compose network.
+map $http_upgrade $connection_upgrade {
+  default upgrade;
+  '' close;
+}
+
+server {
+  listen 443 ssl;
+  server_name REPLACE_HOSTNAME;
+  ssl_certificate REPLACE_CERTIFICATE_PATH;
+  ssl_certificate_key REPLACE_PRIVATE_KEY_PATH;
+
+  location / {
+    proxy_pass http://127.0.0.1:REPLACE_FRONTEND_PORT;
+    proxy_http_version 1.1;
+    proxy_set_header Host $host;
+    proxy_set_header X-Forwarded-Proto https;
+    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+    proxy_set_header Upgrade $http_upgrade;
+    proxy_set_header Connection $connection_upgrade;
+  }
+}
+# Include this template in an Nginx http context. Certificate trust, renewal,
+# firewall exposure and real WSS remain separate runtime gates.

